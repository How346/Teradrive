<Window x:Class="TeraDrive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TeraDrive" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Background="{DynamicResource BgBrush}" Icon="Assets/TeraDrive.ico" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="8,2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="b" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource PanelAltBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style>
    <Style x:Key="TabHost" TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushX}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,20,20,16">
          <TextBlock Text="TeraDrive" FontSize="22" FontWeight="Bold"/>
          <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="Your cloud. Your drive. Your speed."/>
        </StackPanel>
        <ListBox ItemsSource="{Binding Sections}" SelectedIndex="{Binding SelectedSection, Mode=TwoWay}" ItemContainerStyle="{StaticResource NavItem}" AutomationProperties.Name="Navigation"/>
      </DockPanel>
    </Border>

    <TabControl Grid.Row="0" Grid.Column="1" Style="{StaticResource TabHost}" SelectedIndex="{Binding SelectedSection}" Margin="24">
      <!-- 0 Overview -->
      <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="Overview"/>
        <WrapPanel>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock FontWeight="SemiBold" Text="TeraBox"/><TextBlock Style="{StaticResource Muted}" Text="{Binding CloudStatus}" Margin="0,6,0,8"/>
            <Button Content="Connect cloud account" Command="{Binding ConnectTeraBoxCmd}" HorizontalAlignment="Left"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock FontWeight="SemiBold" Text="Active provider"/><TextBlock Style="{StaticResource Muted}" Text="{Binding ProviderStatus}" Margin="0,6,0,0"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Last refresh:"/><TextBlock Text="{Binding SyncText}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock FontWeight="SemiBold" Text="Smart Cache"/><TextBlock Style="{StaticResource Muted}" Text="{Binding CacheSummary}" Margin="0,6,0,8"/>
            <Button Content="Open cache folder" Command="{Binding OpenCacheFolderCmd}" HorizontalAlignment="Left"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock FontWeight="SemiBold" Text="Transfers"/><TextBlock Style="{StaticResource Muted}" Text="{Binding TransferSummary}" Margin="0,6,0,0"/>
            <TextBlock Margin="0,6,0,0"><Run Text="Upload "/><Run Text="{Binding UploadSpeed, Mode=OneWay}"/><Run Text="   Download "/><Run Text="{Binding DownloadSpeed, Mode=OneWay}"/></TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Pause all" Command="{Binding PauseAllCmd}"/><Button Content="Resume all" Command="{Binding ResumeAllCmd}"/></StackPanel></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock FontWeight="SemiBold" Text="Virtual drive"/><TextBlock Style="{StaticResource Muted}" Text="{Binding DriveStatus}" Margin="0,6,0,0"/></StackPanel></Border>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Import files…" Command="{Binding ImportCmd}"/><Button Content="Settings" Command="{Binding GoSettingsCmd}"/></StackPanel>
      </StackPanel></ScrollViewer></TabItem>

      <!-- 1 Files -->
      <TabItem><DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="Files"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button DockPanel.Dock="Left" Content="⬆ Up" Command="{Binding UpCmd}"/>
          <Button DockPanel.Dock="Left" Content="⟳ Refresh" Command="{Binding RefreshCmd}"/>
          <TextBox DockPanel.Dock="Right" Width="200" Margin="8,0,0,8" Text="{Binding FileSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search in this folder" AutomationProperties.Name="Search"/>
          <TextBlock VerticalAlignment="Center" Margin="8,0,0,8" Text="{Binding CurrentPath}" FontWeight="SemiBold"/>
        </DockPanel>
        <WrapPanel DockPanel.Dock="Top">
          <Button Content="Import…" Command="{Binding ImportCmd}"/>
          <Button Content="Download…" Command="{Binding DownloadCmd}" CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}"/>
          <Button Content="New folder" Command="{Binding NewFolderCmd}"/>
          <Button Content="Rename (F2)" Command="{Binding RenameCmd}" CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}"/>
          <Button Content="Delete from provider (Del)" Command="{Binding DeleteCmd}" CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}"/>
          <Button Content="Keep offline (pin)" Command="{Binding PinCmd}" CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}"/>
          <Button Content="Unpin" Command="{Binding UnpinCmd}" CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}"/>
        </WrapPanel>
        <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Rows}" MouseDoubleClick="FilesGrid_DoubleClick" AutomationProperties.Name="File list">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="100"/>
            <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" Width="160"/>
            <DataGridTextColumn Header="Cache state" Binding="{Binding State}" Width="140"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel></TabItem>

      <!-- 2 Transfers -->
      <TabItem><DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="Transfers"/>
        <WrapPanel DockPanel.Dock="Top">
          <Button Content="Pause all" Command="{Binding PauseAllCmd}"/><Button Content="Resume all" Command="{Binding ResumeAllCmd}"/>
          <Button Content="Pause" Command="{Binding PauseJobCmd}" CommandParameter="{Binding SelectedItem, ElementName=JobsGrid}"/>
          <Button Content="Resume" Command="{Binding ResumeJobCmd}" CommandParameter="{Binding SelectedItem, ElementName=JobsGrid}"/>
          <Button Content="Cancel" Command="{Binding CancelJobCmd}" CommandParameter="{Binding SelectedItem, ElementName=JobsGrid}"/>
          <Button Content="Retry" Command="{Binding RetryJobCmd}" CommandParameter="{Binding SelectedItem, ElementName=JobsGrid}"/>
          <Button Content="Clear finished" Command="{Binding ClearFinishedCmd}"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8" Text="Pause/resume and retry restart a transfer from the beginning. Speeds are measured from bytes actually moved and depend on your network and the provider."/>
        <DataGrid x:Name="JobsGrid" ItemsSource="{Binding Jobs}" SelectionMode="Single">
          <DataGrid.Columns>
            <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80"/>
            <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="90"/>
            <DataGridTemplateColumn Header="Progress" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Margin="6,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="Speed" Binding="{Binding SpeedText}" Width="90"/>
            <DataGridTextColumn Header="ETA" Binding="{Binding EtaText}" Width="80"/>
            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="220"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel></TabItem>

      <!-- 3 Cache -->
      <TabItem><DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="Smart Cache"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding CacheSummary}" Margin="0,0,0,8"/>
        <WrapPanel DockPanel.Dock="Top">
          <Button Content="5 GB" Command="{Binding SetCacheGbCmd}" CommandParameter="5"/><Button Content="10 GB" Command="{Binding SetCacheGbCmd}" CommandParameter="10"/>
          <Button Content="25 GB" Command="{Binding SetCacheGbCmd}" CommandParameter="25"/><Button Content="50 GB" Command="{Binding SetCacheGbCmd}" CommandParameter="50"/>
          <Button Content="100 GB" Command="{Binding SetCacheGbCmd}" CommandParameter="100"/>
          <Button Content="Clear unpinned" Command="{Binding ClearCacheCmd}"/><Button Content="Verify integrity" Command="{Binding VerifyCacheCmd}"/><Button Content="Open folder" Command="{Binding OpenCacheFolderCmd}"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8" Text="Clearing the cache only removes local cached copies. Pinned and in-use files are kept. Cloud files and your original files are never touched. Custom limits and the cache folder are in Settings."/>
        <DataGrid ItemsSource="{Binding CacheRows}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="100"/>
            <DataGridTextColumn Header="State" Binding="{Binding Pinned}" Width="140"/><DataGridTextColumn Header="Last used" Binding="{Binding Last}" Width="160"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel></TabItem>

      <!-- 4 Videos -->
      <TabItem><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,16,0">
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="Videos"/>
          <TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding VideoSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search videos"/>
          <WrapPanel DockPanel.Dock="Top"><Button Content="Name" Command="{Binding SortVideosCmd}" CommandParameter="Name"/><Button Content="Date" Command="{Binding SortVideosCmd}" CommandParameter="Date"/><Button Content="Size" Command="{Binding SortVideosCmd}" CommandParameter="Size"/><Button Content="Rescan" Command="{Binding RescanVideosCmd}"/></WrapPanel>
          <DataGrid x:Name="VideoGrid" ItemsSource="{Binding Videos}" SelectionMode="Single" MouseDoubleClick="VideoGrid_DoubleClick">
            <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80"/></DataGrid.Columns>
          </DataGrid>
        </DockPanel>
        <DockPanel Grid.Column="1">
          <TextBlock DockPanel.Dock="Top" Text="{Binding VideoStatus}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
          <ProgressBar DockPanel.Dock="Top" IsIndeterminate="{Binding VideoBusy}" Margin="0,0,0,8"/>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" ValueChanged="SeekSlider_ValueChanged" IsMoveToPointEnabled="True" AutomationProperties.Name="Seek"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Button Content="▶ / ⏸" Click="PlayPause_Click"/><Button Content="⏹" Click="Stop_Click"/><Button Content="⛶ Full screen (F11)" Click="Fullscreen_Click"/>
              <TextBlock VerticalAlignment="Center" Margin="12,0,6,8" Text="Volume"/>
              <Slider Width="120" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center" Margin="0,0,0,8" ValueChanged="Volume_Changed" AutomationProperties.Name="Volume"/>
              <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="12,0,0,8"/>
            </StackPanel>
          </StackPanel>
          <Border Background="Black" CornerRadius="8"><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Volume="0.8" MediaOpened="Player_Opened" MediaFailed="Player_Failed" MediaEnded="Player_Ended"/></Border>
        </DockPanel>
      </Grid></TabItem>

      <!-- 5 Games -->
      <TabItem><DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="Games"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8" Text="Launch shortcuts for locally installed games. Cloud storage is not cloud gaming: keep installers/backups in the cloud, download, install locally, then launch. Removing a shortcut never deletes game files."/>
        <WrapPanel DockPanel.Dock="Top"><Button Content="Add game…" Command="{Binding AddGameCmd}"/>
          <Button Content="Launch" Command="{Binding LaunchGameCmd}" CommandParameter="{Binding SelectedItem, ElementName=GameGrid}"/>
          <Button Content="Open folder" Command="{Binding OpenGameFolderCmd}" CommandParameter="{Binding SelectedItem, ElementName=GameGrid}"/>
          <Button Content="Remove shortcut" Command="{Binding RemoveGameCmd}" CommandParameter="{Binding SelectedItem, ElementName=GameGrid}"/></WrapPanel>
        <DataGrid x:Name="GameGrid" ItemsSource="{Binding GameRows}" SelectionMode="Single">
          <DataGrid.Columns><DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="Install folder" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Size on disk" Binding="{Binding Size}" Width="110"/></DataGrid.Columns>
        </DataGrid>
      </DockPanel></TabItem>

      <!-- 6 Settings -->
      <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource H1}" Text="Settings"/>
        <Button Content="Toggle dark / light theme" Command="{Binding ToggleThemeCmd}" HorizontalAlignment="Left"/>
        <TextBlock Text="Cache folder (empty = default)" Margin="0,8,0,2"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCacheDirCmd}" Margin="8,0,0,0"/><TextBox Text="{Binding CacheDirText}"/></DockPanel>
        <TextBlock Text="Cache size limit (GB, custom)" Margin="0,8,0,2"/><TextBox Text="{Binding CacheGbText}"/>
        <TextBlock Text="Local test-provider folder (empty = Documents\TeraDrive-LocalProvider)" Margin="0,8,0,2"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseLocalRootCmd}" Margin="8,0,0,0"/><TextBox Text="{Binding LocalRootText}"/></DockPanel>
        <TextBlock Text="Upload concurrency (1–16)" Margin="0,8,0,2"/><TextBox Text="{Binding UploadConcText}"/>
        <TextBlock Text="Download concurrency (1–16)" Margin="0,8,0,2"/><TextBox Text="{Binding DownloadConcText}"/>
        <TextBlock Style="{StaticResource Muted}" Text="More concurrency does not guarantee more speed; results depend on your network and provider limits." FontSize="11"/>
        <TextBlock Text="Retries per transfer (0–10)" Margin="0,8,0,2"/><TextBox Text="{Binding RetryText}"/>
        <TextBlock Text="Preferred drive letter (D–Z) — the virtual drive is not implemented yet" Margin="0,8,0,2"/><TextBox Text="{Binding DriveLetterText}"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Save" Command="{Binding SaveSettingsCmd}"/><Button Content="Reset to defaults" Command="{Binding ResetSettingsCmd}"/></StackPanel>
        <TextBlock Style="{StaticResource Muted}" Text="Privacy: TeraDrive stores no passwords or cookies. No data is sent anywhere by this app."/>
      </StackPanel></ScrollViewer></TabItem>

      <!-- 7 Diagnostics -->
      <TabItem><DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="Diagnostics"/>
        <WrapPanel DockPanel.Dock="Top"><Button Content="Export redacted log…" Command="{Binding ExportDiagCmd}"/><Button Content="Try to mount virtual drive" Command="{Binding MountCmd}"/></WrapPanel>
        <ListBox ItemsSource="{Binding LogLines}" FontFamily="Consolas"/>
      </DockPanel></TabItem>
    </TabControl>

    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushX}" BorderThickness="0,1,0,0" Padding="16,6">
      <DockPanel><ProgressBar DockPanel.Dock="Right" Width="120" IsIndeterminate="{Binding IsBusy}"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></DockPanel>
    </Border>
  </Grid>
</Window>
